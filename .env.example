NEXT_PUBLIC_SUPABASE_URL=https://ouspsmuyzwglwxjdxkls.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key-here
NEXT_PUBLIC_SITE_URL=https://pisiqueoraculo.com.br
NEXT_PUBLIC_STRIPE_ANNUAL_PRODUCT_ID=prod_xxxxxxxxx
# Price IDs do Stripe (web) por plano. O valor cobrado e o definido no proprio
# Price dentro do Stripe. Crie um Price para cada plano e cole o ID aqui:
#   - Anual   R$ 59,90/ano
#   - Mensal  R$ 9,90/mes
#   - 6 meses R$ 39,90 a cada 6 meses
NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID=price_xxxxxxxxx
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID=price_xxxxxxxxx
NEXT_PUBLIC_STRIPE_SEMESTRAL_PRICE_ID=price_xxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxx
# Stripe (web): segredo do webhook. Dashboard > Developers > Webhooks.
# SEM isto o webhook rejeita os eventos e a assinatura WEB nao ativa o Premium.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxx

# RevenueCat (assinaturas no APP Android). ATENCAO: sem esta chave o RevenueCat
# NAO inicializa e NENHUMA compra dentro do app funciona (causa provavel de 0
# assinantes). Use a chave PUBLICA do Google (comeca com "goog_"), no painel
# do RevenueCat em Project settings > API keys. Precisa existir no BUILD do app.
NEXT_PUBLIC_REVENUECAT_GOOGLE_API_KEY=goog_xxxxxxxxxxxxxxxx
